{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nodal",
  "version": "../package.json",
  "identifier": "io.github.mazp17.nodal",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nodal",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3OUZENDM2QzlBNzIyQTkKUldTcElxZkpOdFNmUng5ZVhXbDhtMm5uVDdQZ2crNjhWSnVyVFNWTDNRc2IxYnJZbXI5ZDU3WWgK",
      "endpoints": [
        "https://github.com/Mazp17/nodal-agentos/releases/latest/download/latest.json"
      ]
    }
  }
}
